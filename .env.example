# Safe local development defaults only. Do not add credentials here.
VITE_API_BASE_URL=http://127.0.0.1:8001
# Server-side only. Replace the example contact with your actual app/contact.
NWS_USER_AGENT=ClosureOps/0.1 (your-app.example, your-contact@example.org)
# Server-side observation freshness only; prototype window, not flood policy.
USGS_FRESHNESS_MINUTES=120

# Task 9A server-only local API settings; writes are disabled by default.
# Uvicorn does not auto-load this file; use the documented PowerShell startup.
CLOSUREOPS_LOCAL_DEMO_WRITES=false
# Task 10B server-only opt-in; key is supplied privately in the server process.
CLOSUREOPS_AI_BRIEFING_ENABLED=false
CLOSUREOPS_ENVIRONMENT=local_demo
CLOSUREOPS_BIND_HOST=127.0.0.1
# Optional trusted local SQLite path (never a frontend or HTTP input):
# CLOSUREOPS_DEMO_DATABASE=backend/data/manager-decisions.sqlite3
